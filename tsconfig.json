{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "./src",
    "paths": {
      "@essethr/shared": ["../packages/shared/index.js"],
      "@essethr/shared/*": ["../packages/shared/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.js"]
}
