# Server
PORT=4000

# MongoDB — required for production; defaults to local mongodb for dev if omitted
# Local (install MongoDB or use Docker): mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=payrollex

# Auth — required when NODE_ENV=production (min 32 characters)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Token lifetimes (optional)
# ACCESS_TOKEN_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY=7d

# Account security (optional)
# AUTH_MAX_FAILED_ATTEMPTS=5
# AUTH_LOCKOUT_MS=900000

# Request limits (optional)
# REQUEST_JSON_LIMIT=1mb
# REQUEST_URLENCODED_LIMIT=1mb
# UPLOAD_DOCUMENT_MAX_BYTES=10485760

# Rate limiting — set RATE_LIMIT_DISABLED=false to enforce global limiter in dev
# RATE_LIMIT_DISABLED=false

# Cloudinary (uploads) — optional for some endpoints
CLOUD_NAME=
API_KEY=
API_SECRET=

# Dev seed (optional) — used by: npm run seed:dev
# DEV_ADMIN_EMAIL=admin@essethr.local
# DEV_ADMIN_PASSWORD=DevAdmin123!

# Full demo dataset — used by: npm run seed:demo  (after seed:dev)
# SEED_FORCE=1 npm run seed:demo   — re-seed demo rows
# DEV_DEMO_PASSWORD=DemoPass123!

# CORS — required in production (comma-separated SPA origins)
# CORS_ORIGINS=https://your-app.example,https://www.your-app.example

# Redis — optional; enables distributed token blacklist (recommended in production)
# REDIS_URL=redis://127.0.0.1:6379

# Report schedule runner interval (ms, optional)
# REPORT_SCHEDULE_INTERVAL_MS=3600000

# Mongoose user repository (optional)
# USE_MONGOOSE_USERS=true
